#include <stdio.h>

Int main() {
    // Declaracao das variaveis
    Float salario_minimo, valor_kilowatt, kwh_consumido;
    Float valor_pago_residencia, valor_com_desconto;

    // Entrada de dados
    Printf(“Digite o valor do salario minimo: “);
    Scanf(“%f”, &salario_minimo);

    Printf(“Digite a quantidade de kWh consumido pela residencia: “);
    Scanf(“%f”, &kwh_consumido);  

    // Processamento 
    Valor_kilowatt = salario_minimo / 500.0;
    Valor_pago_residencia = kwh_consumido * valor_kilowatt;
    Valor_com_desconto = valor_pago_residencia * 0.85; // 15% de desconto

    // Saida de dados
    Printf(“O valor em reais de cada kilowatt: %.2f\n”, valor_kilowatt);
    Printf(“O valor em reais a ser pago por essa residencia: %.2f\n”, valor_pago_residencia);
    Printf(“O novo valor a ser pago com 15%% de desconto: %.2f\n”, valor_com_desconto);      

    return 0;
}    
 
