    Scanf(“%d”, &num_apartamentos);

    Printf(“Digite o valor da diaria normal para o final de semana completo: R$ “);
    Scanf(“%f”, &valor_diaria_normal);

    // Cálculos
    // 1. Valor promocional com 25% de desconto
    Valor_diaria_promo = valor_diaria_normal * 0.75;

    // 2. Total arrecadado com 100% de ocupação (usando valor promocional)
    Arrecadacao_100 = num_apartamentos * valor_diaria_promo;

    // 3. Total arrecadado com 70% de ocupação (usando valor promocional)
    Arrecadacao_70 = (num_apartamentos * 0.70) * valor_diaria_promo;

    // 4. Valor que deixou de arrecadar na ocupação de 100% comparado ao valor normal
    Prejuizo_promocao = (num_apartamentos * valor_diaria_normal) – arrecadacao_100;

    // Exibição dos resultados
    Printf(“\n=== RESULTADOS DA PROMOÇÃO ===\n”);
    Printf(“• Valor promocional da diaria: R$ %.2f\n”, valor_diaria_promo);
    Printf(“• Total arrecadado com 100%% de ocupacao: R$ %.2f\n”, arrecadacao_100);
    Printf(“• Total arrecadado com 70%% de ocupacao: R$ %.2f\n”, arrecadacao_70);
    Printf(“• Valor deixado de arrecadar devido ao desconto (com 100%% ocupado): R$ %.2f\n”, prejuizo_promocao);

    Return 0;
}

