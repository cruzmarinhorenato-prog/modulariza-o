#include <math.h> // 

int main() {
    // Declaração das variáveis
    float poupanca_programada, valor_acumulado;
    float taxa_juros = 0.005; // 0.5% ao mês (i)
    int meses = 12;           // Exemplo: 12 meses (n)

    // Entrada de dados
    Printf(“Digite a aplicacao da poupanca programada: “);
    scanf(“%f”, &poupanca_programada);

    // Processamento 
    valor_acumulado = poupanca_programada * ((pow(1 + taxa_juros, meses) – 1) / taxa_juros);

    // Saída
    Printf(“A aplicacao da poupanca programada acumulou: R$ %.2f\n”, valor_acumulado);

    return 0;
}

