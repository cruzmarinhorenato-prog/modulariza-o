#include <stdio.h>

int main() {
    float a, b, c, d, e, f;
    float D, Dx, Dy, x, y;

    // Leitura dos coeficientes
    printf(“Digite os coeficientes a, b, c (primeira equacao):\n”);
    scanf(“%f %f %f”, &a, &b, &c);

    printf(“Digite os coeficientes d, e, f (segunda equacao):\n”);
    scanf(“%f %f %f”, &d, &e, &f);

    //processamento 
    D  = (a * e) – (b * d);
    Dx = (c * e) – (b * f);
    Dy = (a * f) – (c * d);

    if(D != 0) {
        X = Dx / D;
        Y = Dy / D;
        printf(“Sistema Possivel e Determinado (SPD).\n”);
        printf(“x = %.2f\n”, x);
        printf(“y = %.2f\n”, y);
    } else {
        if (Dx != 0 || Dy != 0) {
            printf(“Sistema Impossivel (SI): não há solucao.\n”);
        } else {
            printf(“Sistema Indeterminado (SPI): infinitas solucoes.\n”);
        }
    }

    return 0;
}



