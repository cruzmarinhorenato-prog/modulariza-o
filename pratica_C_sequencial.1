Int main() {
    Float custo_espetaculo, preco_convite;
    Float lucro_desejado_valor, faturamento_lucro;
    Int qtd_para_custo, qtd_para_lucro;

    // Entrada de dados
    Printf(“Digite o custo do espetaculo: “);
    Scanf(“%f”, &custo_espetaculo);

    Printf(“Digite o preco do convite: “);
    Scanf(“%f”, &preco_convite);

    // Evita divisao por zero
    If (preco_convite <= 0) {
        Printf(“O preco do convite deve ser maior que zero.\n”);
        Return 1;
    }

    // Calculo da quantidade para cobrir apenas os custos (arredondando para cima com ceil)
    Qtd_custo = ceil(custo_espetaculo / preco_convite);

    // Calculo do lucro de 23% sobre o custo
    Lucro_desejado_valor = custo_espetaculo * 0.23;
    Faturamento_lucro = custo_espetaculo + lucro_desejado_valor;
    Qtd_lucro = ceil(faturamento_lucro / preco_convite);

    // Saida de resultados
    Printf(“\n--- RESULTADOS ---\n”);
    Printf(“Quantidade de convites para cobrir os custos: %d\n”, qtd_custo);
    Printf(“Lucro desejado (23%): R$ %.2f\n”, lucro_desejado_valor);
    Printf(“Quantidade de convites para obter o lucro de 23%: %d\n”, qtd_lucro);

    Return 0;
}

