#include <stdio.h>

int main() {
    int total_Eleitores, votosC1, votosC2, brancos_Nulos;
    float percC1, percC2, percBrancos_Nulos;

    // Leitura dos dados
    printf("Digite o numero total de eleitores: ");
    scanf("%d", &total_Eleitores);

    printf("Digite os votos do primeiro candidato: ");
    scanf("%d", &votosC1);

    printf("Digite os votos do segundo candidato: ");
    scanf("%d", &votosC2);

    // Calculo dos votos brancos, nulos ou abstencoes
    brancos_Nulos = total_Eleitores – (votosC1 + votosC2);

    // Calculo dos percentuais (com cast para float para evitar divisao inteira)
    percC1 = ((float)votosC1 / total_Eleitores) * 100;
    percC2 = ((float)votosC2 / total_Eleitores) * 100;
    percBrancosNulos = ((float)brancos_Nulos / totalEleitores) * 100;

    // Exibicao dos resultados
    printf("\n--- RESULTADO DA ELEICAO ---\n");
    printf("Candidato 1: %.2f%% dos votos.\n", percC1);
    printf("Candidato 2: %.2f%% dos votos.\n", percC2);
    printf("Brancos/Nulos/Abstencoes: %.2f%%.\n", percBrancosNulos);

    return 0;
}


















