#include <stdio.h>

Int main() {
    // Declaração das variáveis
    Float valor_pago = 0;
    Float troco = 0;
    Float total_compra = 0;
    Float preco_produto = 0;

    // Entrada de dados: Leitura do preço de 5 produtos
    Printf(“--- Entrada de Produtos ---\n”);
    For (int i = 1; i <= 5; i++) {
        Printf(“Digite o valor do produto %d: R$ “, i);
        Scanf(“%f”, &preco_produto);
        Total_compra += preco_produto; // Acumula o valor no total
    }

    // Exibe o total da compra e pede o pagamento
    Printf(“\nTotal da compra: R$ %.2f\n”, total_compra);
    Printf(“Digite o valor pago pelo cliente: R$ “);
    Scanf(“%f”, &valor_pago);

    // Processamento: Cálculo do troco
    Troco = valor_pago – total_compra;

    // Saída de dados com validação simples
    If (troco < 0) {
        Printf(“\nValor pago é insuficiente! Falta: R$ %.2f\n”, -troco);
    } else {
        Printf(“\nInforme o troco que sera devolvido: R$ %.2f\n”, troco);
    }

    return 0;
}

