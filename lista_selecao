    float valor_hora_trabalhada, valor_horas_extras, salario_bruto;
    float IRRF = 0, salario_liquido;

    // Entrada de dados
    printf("Digite o salario minimo: ");
    scanf("%f", &salario_minimo);

    printf("Digite o numero de horas trabalhadas: ");
    scanf("%f", &numero_horas_trabalhadas);

    printf("Digite a quantidade de dependentes do funcionario: ");
    scanf("%f", &dependentes_do_funcionario);

    printf("Digite a quantidade de horas extras trabalhadas: ");
    scanf("%f", &quantidade_horas_extras);

    // Processamento dos valores base
    valor_hora_trabalhada = salario_minimo / 5.0;
    salario_do_mes = numero_horas_trabalhadas * valor_hora_trabalhada;

    // Valor por dependente (ex: R$ 32,00 por dependente)
    valor_dependentes = dependentes_do_funcionario * 32.0;


    valor_horas_extras = quantidade_horas_extras * (valor_hora_trabalhada * 1.5);

    // Cálculo do Salário Bruto
    salario_bruto = salario_do_mes + valor_dependentes + valor_horas_extras;

    // Cálculo do IRRF com base no Salário Bruto
    if (salario_bruto < 200.0) {
        printf("\nSalario Bruto inferior a 200.0: R$ %.2f\n", salario_bruto);
        IRRF = 0.0;
    }
    else if (salario_bruto >= 200.0 && salario_bruto <= 500.0) {
        printf("\nSalario Bruto entre 200.0 e 500.0: R$ %.2f\n", salario_bruto);
        IRRF = salario_bruto * 0.10;
    }
    else {
        printf("\nSalario Bruto superior a 500.0: R$ %.2f\n", salario_bruto);
        IRRF = salario_bruto * 0.20;
    }

    // Salário Líquido
      salario_liquido = salario_bruto - IRRF;


    if (salario_liquido <= 350.0) {
        printf("Gratificacao de 100 reais aplicada.\n");
        salario_liquido += 100.0;
    }
    else {
        printf("Gratificacao de 50 reais aplicada.\n");
        salario_liquido += 50.0;
    }

    // Saída final do programa
    printf("Salario liquido final: R$ %.2f\n", salario_liquido);

    return 0;
}
    
