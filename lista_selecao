    scanf("%f" , &a);
    printf("Digite o valor de b: ");
    scanf("%f" , &b);
    printf("Digite o valor de c: ");
    scanf("%f" , &c);
//Processamento
    delta = (b * b) - (4 * a * c);
    printf("Calcule o delta:%.2f\n", delta);

    if(delta < 0){
        printf("A equacao nao possui raizes reis.\n");
    }
    else if(delta == 0){
        x1 = -b / (2 * a);
        printf("Delta zero,raiz unica: x = %.2f\n", x1);
    }
    else {
        x1 = (-b + sqrt(delta)) / (2 * a);
        x2 = (-b - sqrt(delta)) / (2 * a);
        printf("Duas raizes reais: x1 = %.2f e x2 = %.2f\n", x1, x2);
    }

    return 0;
}

