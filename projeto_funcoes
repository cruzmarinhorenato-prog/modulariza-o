#include <stdio.h>
#include <string.h>

// --- FUNÇÃO 1: Resolve um bloco de 3 dígitos (centena, dezena e unidade) ---
Void escrever_trio(int numero, char* buffer) {
    Char* unidades[] = {“”, “um”, “dois”, “três”, “quatro”, “cinco”, “seis”, “sete”, “oito”, “nove”};
    Char* especiais[] = {“dez”, “onze”, “doze”, “treze”, “quatorze”, “quinze”, “dezesseis”, “dezessete”, “dezoito”, “dezenove”};
    Char* dezenas[] = {“”, “”, “vinte”, “trinta”, “quarenta”, “cinquenta”, “sessenta”, “setenta”, “oitenta”, “noventa”};
    Char* centenas[] = {“”, “cento”, “duzentos”, “trezentos”, “quatrocentos”, “quinhentos”, “seiscentos”, “setecentos”, “oitocentos”, “novecentos”};

    If (numero == 100) {
        Strcat(buffer, “cem”);
        Return;
    }

    Int c = numero / 100;
    Int resto = numero % 100;
    Int d = resto / 10;
    Int u = resto % 10;

    If (c > 0) {
        Strcat(buffer, centenas[c]);
        If (resto > 0) strcat(buffer, “ e “);
    }

    If (resto > 0) {
        If (resto < 10) {
            Strcat(buffer, unidades[u]);
        } else if (resto >= 10 && resto <= 19) {
            Strcat(buffer, especiais[resto – 10]);
        } else {
            Strcat(buffer, dezenas[d]);
            If (u > 0) {
                Strcat(buffer, “ e “);
                Strcat(buffer, unidades[u]);
            }
        }
    }
}

// --- FUNÇÃO 2: Decide a pontuação correta (“ e “ ou “, “) entre os blocos ---
Void adicionar_conector(long long int resto, char* buffer) {
    If (resto > 0) {
        // Regra do português: se o que sobrar for menor que 100 ou uma centena exata (ex: 300), usa “ e “
        If (resto < 100 || resto % 100 == 0) {
            Strcat(buffer, “ e “);
        } else {
            Strcat(buffer, “, “);
        }
    }
}

// --- FUNÇÃO 3: Controla a lógica dos 10 dígitos (Bilhões, Milhões, Milhares) ---
Void numero_por_extenso(long long int numero) {
    If (numero == 0) {
        Printf(“zero\n”);
        Return;
    }

    // Buffer de 500 caracteres garante espaço suficiente para o texto extenso por completo
    Char resultado[500] = “”; 

    // Extrai cada pedaço de 3 dígitos do número de 10 dígitos
    Int bilhoes  = (numero / 1000000000LL) % 1000;
    Int milhoes  = (numero / 1000000LL) % 1000;
    Int milhares = (numero / 1000LL) % 1000;
    Int unidades = numero % 1000;

    // Processa os Bilhões
    If (bilhoes > 0) {
        Escrever_trio(bilhoes, resultado);
        If (bilhoes == 1) strcat(resultado, “ bilhão”);
        Else strcat(resultado, “ bilhões”);
        
        Adicionar_conector(numero % 1000000000LL, resultado);
    }

    // Processa os Milhões
    If (milhoes > 0) {
        Escrever_trio(milhoes, resultado);
        If (milhoes == 1) strcat(resultado, “ milhão”);
        Else strcat(resultado, “ milhões”);
        
        Adicionar_conector(numero % 1000000LL, resultado);
    }

    // Processa os Milhares
    If (milhares > 0) {
        // Regra gramatical: omite-se “um” antes de mil isolado (ex: “mil”, não “um mil”)
        If (milhares == 1) {
            Strcat(resultado, “mil”);
        } else {
            Escrever_trio(milhares, resultado);
            Strcat(resultado, “ mil”);
        }
        
        Adicionar_conector(numero % 1000LL, resultado);
    }

    // Processa as Unidades simples
    If (unidades > 0) {
        Escrever_trio(unidades, resultado);
    }

    // Exibe o texto completo acumulado no buffer
    Printf(“%s\n”, resultado);
}

// --- FUNÇÃO PRINCIPAL: Ponto de entrada do programa ---
Int main() {
    Long long int num;

    Printf(“Digite um número inteiro (até 10 dígitos): “);
    If (scanf(“%lld”, &num) != 1) {
        Printf(“Erro: Entrada inválida.\n”);
        Return 1;
    }

    // Validação de limite para 10 dígitos (máximo: 9.999.999.999)
    If (num < 0 || num > 9999999999LL) {
        Printf(“Erro: O número deve estar entre 0 e 9.999.999.999.\n”);
    } else {
        Printf(“Por extenso: “);
        Numero_por_extenso(num);
    }

    Return 0;
}



